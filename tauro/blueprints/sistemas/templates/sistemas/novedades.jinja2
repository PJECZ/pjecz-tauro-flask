{% extends 'layouts/app.jinja2' %}
{% import 'macros/card.jinja2' as card %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}Novedades{% endblock %}

{% block topbar_actions %}
    {{ topbar.page('Historial de Cambios') }}
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            {% for n in novedades %}
                {% call card.card(title='Versión ' ~ n.version ~ (' (' ~ n.fecha ~ ')' if n.fecha else '')) %}
                    <div class="text-start">
                        {% for seccion in n.secciones %}
                            <h6 class="{% if not loop.first %}mt-3{% endif %}">{{ seccion.titulo }}</h6>
                            <ul>
                                {% for item in seccion['items'] %}
                                    <li>{{ item }}</li>
                                {% endfor %}
                            </ul>
                        {% endfor %}
                    </div>
                {% endcall %}
            {% else %}
                {% call card.card() %}
                    <p class="text-muted mb-0">No hay novedades disponibles.</p>
                {% endcall %}
            {% endfor %}
            <p class="text-center">
                <a class="btn btn-outline-secondary" href="{{ url_for('sistemas.about') }}">Volver a Acerca de</a>
            </p>
        </div>
    </div>
{% endblock %}
