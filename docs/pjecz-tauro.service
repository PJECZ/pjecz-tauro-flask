[Unit]
Description=Servicio Flask para PJECZ Tauro
After=network.target

[Service]
User=pjecz-tauro
Group=pjecz-tauro
WorkingDirectory=/home/pjecz-tauro/github/PJECZ/pjecz-tauro-flask
# Asegúrate de que el PYTHONPATH incluya la raíz del proyecto
ExecStart=/home/pjecz-tauro/.local/bin/uv run flask run --host=0.0.0.0 --port=5020
Restart=always

[Install]
WantedBy=multi-user.target

